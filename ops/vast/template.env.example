# Public, non-secret template settings. Use the image's native Entrypoint mode.
NVIDIA_DRIVER_CAPABILITIES=compute,video,utility
PROVISIONING_SCRIPT=https://raw.githubusercontent.com/Liovinn/clip-personal/main/ops/vast/bootstrap.sh
ENABLE_HTTPS=true
ENABLE_AUTH=true
PORTAL_CONFIG=localhost:1111:11111:/:Instance Portal|localhost:8080:18080:/:Jupyter|localhost:5176:5175:/:OpenShorts
VITE_EXTRA_ALLOWED_HOSTS=.trycloudflare.com
# Request TCP ports 22, 1111, 8080, and 5176 in the template's Ports section.
# Optional: add OPENSHORTS_DRIVE_CONNECTION_ID after connecting Drive in Vast.
# Never put API keys, Google tokens, or WEB_PASSWORD in this public file.
